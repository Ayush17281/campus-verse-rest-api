<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus-Verse</title>
    
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Griffy&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Danfo&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Campus-Verse VIT <br>Let's Connect Share and Grow</h1>
    <p class="tagline text-center fs-5 mb-4">
    Create an anonymous username and freely share your posts, opinions, and experiences related to college life — without the fear of judgment.</p>
<div class="container">
    <% for(post of posts) { %>
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
        <h5 class="card-title text-primary">@<%= post.username %></h5>
        <p class="card-text"><%= post.content %></p>
        <a href="/posts/<%= post.id %>" class="btn btn-primary">See in Detail</a>
        <a href="/posts/<%= post.id %>/edit" class="btn btn-secondary">Edit Post</a>
    <form method="post" action="/posts/<%= post.id %>?_method=DELETE" class="d-inline">
<button type="submit" class="btn btn-danger">Delete Post</button>
            </form>
            </div>
        </div>
    <% } %>
    <a href="/posts/new" class="btn btn-success">
        Create New Post
    </a>
</div>
</body>
</html>