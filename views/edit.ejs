<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Post</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container mt-4">
  <h2>Edit this Post</h2>
     <h5>Id : <%= post.id %></h5>
          <h5>Username : <%= post.username %></h5>
        <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
<textarea name="content" class="form-control mt-3 mb-3" placeholder="Type new content" rows="6"><%= post.content %></textarea>
<button type="submit" class="btn btn-primary">Update Details</button>
<a href="/posts" class="btn btn-success">Cancel</a>
</form>
</div>
</body>
</html>